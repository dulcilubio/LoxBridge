    "HealthKit access was removed. Re-authorize in Settings to resume automatic uploads." : {
      "comment" : "AppViewModel - error shown when HealthKit permission is revoked",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k HealthKit byl odebrán. Znovu autorizujte v Nastavení pro obnovení automatického nahrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit-adgang blev fjernet. Genautoriser i Indstillinger for at genoptage automatiske uploads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit-Zugriff wurde entfernt. Autorisiere erneut in den Einstellungen, um automatische Uploads fortzusetzen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit juurdepääs eemaldati. Automaatsete üleslaadimiste jätkamiseks volita seadetes uuesti."
