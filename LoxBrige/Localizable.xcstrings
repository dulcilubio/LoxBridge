    "For any privacy-related questions or data deletion requests regarding data on Livelox, contact Livelox support directly." : {
      "comment" : "Section in the PrivacyView that provides contact information for Livelox support.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro jakékoli dotazy týkající se ochrany soukromí nebo žádosti o odstranění dat na Livelox se obraťte přímo na podporu Livelox."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For spørgsmål om databeskyttelse eller anmodninger om sletning af data på Livelox bedes du kontakte Livelox support direkte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei datenschutzbezogenen Fragen oder Anfragen zur Datenlöschung auf Livelox wende dich bitte direkt an den Livelox-Support."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privaatsusega seotud küsimuste või Livelox'il andmete kustutamise taotluste korral võtke otse ühendust Livelox'i toega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livelox'in tietosuojaan liittyvissä kysymyksissä tai tietojen poistopyynnöissä ota suoraan yhteyttä Livelox'in tukeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour toute question relative à la confidentialité ou demande de suppression de données sur Livelox, contactez directement le support Livelox."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For spørsmål om personvern eller forespørsler om sletting av data på Livelox, kontakt Livelox-support direkte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid integritetsfrågor eller begäran om radering av data på Livelox, kontakta Livelox support direkt."
          }
        }
      }
    },
