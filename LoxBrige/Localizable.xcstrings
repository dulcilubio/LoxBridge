    "LoxBridge" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "LoxBridge contains no advertising SDKs, no analytics trackers, and no crash reporting services that transmit your data to third parties." : {
      "comment" : "Text displayed in a privacy row that explains that LoxBridge does not use any advertising SDKs, analytics trackers, or crash reporting services.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge neobsahuje žádné reklamní SDK, analytické sledovače ani služby hlášení chyb, které by přenášely vaše data třetím stranám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge indeholder ingen reklame-SDK'er, analysesporere eller fejlrapporteringstjenester, der overfører dine data til tredjeparter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge enthält keine Werbe-SDKs, keine Analyse-Tracker und keine Absturzmelde-Dienste, die deine Daten an Dritte übertragen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge ei sisalda reklaamiSDK-sid, analüütikajälgijaid ega veaanalüüsiteenuseid, mis edastaksid su andmeid kolmandatele osapooltele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge ei sisällä mainosSDK:ita, analytiikkaseurantaa eikä kaatumisraportointipalveluita, jotka välittäisivät tietojasi kolmansille osapuolille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge ne contient aucun SDK publicitaire, aucun traqueur analytique, ni aucun service de rapport de plantage qui transmette vos données à des tiers."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge inneholder ingen reklame-SDK-er, analysesporere eller krasjrapporteringstjenester som overfører dataene dine til tredjeparter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge innehåller inga annons-SDK:er, analysspårare eller kraschrapporteringstjänster som överför dina data till tredje part."
          }
        }
      }
    },
    "LoxBridge is designed to keep you in control of your personal data. Here's exactly what the app does with it." : {
      "comment" : "A privacy notice that describes how LoxBridge uses user data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge je navržen tak, aby vám poskytl kontrolu nad vašimi osobními daty. Zde je přesně to, co aplikace s vašimi daty dělá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge er designet til at holde dig i kontrol over dine personlige data. Her er præcis, hvad appen gør med dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge ist darauf ausgelegt, dir die Kontrolle über deine persönlichen Daten zu geben. Hier erfährst du genau, was die App damit macht."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge on loodud selleks, et hoida su isikuandmed sinu kontrolli all. Siin on täpselt see, mida rakendus nendega teeb."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge on suunniteltu pitämään sinut hallinnassa henkilötietojesi suhteen. Tässä on tarkalleen mitä sovellus tekee niillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge est conçu pour vous garder en contrôle de vos données personnelles. Voici exactement ce que fait l'application avec celles-ci."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge er utformet for å holde deg i kontroll over dine personlige data. Her er nøyaktig hva appen gjør med dem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge är utformat för att hålla dig i kontroll över dina personuppgifter. Här är exakt vad appen gör med dem."
          }
        }
      }
    },
    "LoxBridge itself has no accounts and stores no personal information on any server. All settings and route history are stored locally on your device." : {
      "comment" : "Text displayed in a privacy notice that informs users that LoxBridge does not store any user data on a server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge sám o sobě nemá žádné účty a neukládá žádné osobní informace na žádný server. Všechna nastavení a historie tras jsou uloženy lokálně ve vašem zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge har ingen konti og gemmer ingen personlige oplysninger på nogen server. Alle indstillinger og rutehistorik gemmes lokalt på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge selbst hat keine Konten und speichert keine personenbezogenen Daten auf einem Server. Alle Einstellungen und der Routenverlauf werden lokal auf deinem Gerät gespeichert."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridgel endal ei ole kontosid ega salvestata isikuandmeid ühelgi serveril. Kõik seaded ja raja ajalugu salvestatakse kohalikult su seadmesse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridgellä ei ole tilejä eikä se tallenna henkilökohtaisia tietoja millekään palvelimelle. Kaikki asetukset ja reittien historia tallennetaan paikallisesti laitteeseesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lui-même n'a pas de comptes et ne stocke aucune information personnelle sur aucun serveur. Tous les réglages et l'historique des parcours sont stockés localement sur votre appareil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge selv har ingen kontoer og lagrer ingen personlig informasjon på noen server. Alle innstillinger og rutehistorikk lagres lokalt på enheten din."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge självt har inga konton och lagrar inga personuppgifter på någon server. Alla inställningar och rutthistorik lagras lokalt på din enhet."
          }
        }
      }
    },
    "LoxBridge only reads health data in direct response to a completed workout notification. It does not run persistent background processes that sample your location or health." : {
      "comment" : "Privacy row for the \"No background data collection\" section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge čte zdravotní data pouze jako přímou odpověď na oznámení o dokončeném tréninku. Nespouští trvalé procesy na pozadí, které by vzorkovaly vaši polohu nebo zdraví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge læser kun sundhedsdata som direkte reaktion på en afsluttet træningsnotifikation. Den kører ikke vedvarende baggrundsprocesser, der registrerer din lokation eller sundhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge liest Gesundheitsdaten nur als direkte Reaktion auf eine abgeschlossene Trainingsbenachrichtigung. Es werden keine dauerhaften Hintergrundprozesse ausgeführt, die deinen Standort oder deine Gesundheit abfragen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge loeb terviseandmeid ainult otsese vastusena lõpetatud treeningu teatisele. See ei käivita püsivaid taustaprotsesse, mis võtaksid proove su asukohast või tervisest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lukee terveystietoja vain suorana vastauksena suoritetun harjoituksen ilmoitukseen. Se ei suorita pysyviä taustaprosesseja, jotka näytteistavat sijaintiasi tai terveyttäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge ne lit les données de santé qu'en réponse directe à une notification d'entraînement terminé. Il ne fait pas tourner de processus d'arrière-plan persistants qui échantillonnent votre localisation ou votre santé."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge leser kun helsedata som direkte svar på en fullført treningsvarsel. Den kjører ikke vedvarende bakgrunnsprosesser som tar målinger av din plassering eller helse."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge läser hälsodata endast som ett direkt svar på ett avslutat träningsmeddelande. Den kör inte beständiga bakgrundsprocesser som samplar din plats eller hälsa."
          }
        }
      }
    },
    "LoxBridge reads your activity GPS routes from Apple Health and sends them to Livelox — only when you choose. Your data never goes anywhere else, is never sold, and is never used for advertising." : {
      "comment" : "OnboardingView - privacy statement",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge čte GPS trasy vašich aktivit z Apple Health a odesílá je do Livelox — pouze když to zvolíte. Vaše data nikam jinam nejdou, nikdy se neprodávají a nikdy se nepoužívají pro reklamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge læser dine aktivitets-GPS-ruter fra Apple Helbred og sender dem til Livelox — kun når du vælger det. Dine data havner aldrig et andet sted, sælges aldrig og bruges aldrig til reklame."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge liest deine Aktivitäts-GPS-Routen aus Apple Gesundheit und sendet sie an Livelox — nur wenn du es wählst. Deine Daten gehen nirgendwo sonst hin, werden nie verkauft und nie für Werbung verwendet."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge loeb sinu tegevuse GPS-radasid Apple Tervisest ja saadab need Liveloxisse — ainult siis, kui sa seda valid. Sinu andmed ei lähe kuhugi mujale, neid ei müüda kunagi ega kasutata kunagi reklaamiks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lukee aktiviteetti-GPS-reittisi Apple Terveydestä ja lähettää ne Liveloxiin — vain kun valitset niin. Tietosi eivät mene minnekään muualle, niitä ei koskaan myydä eikä käytetä mainontaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lit vos itinéraires GPS d'activité depuis Apple Santé et les envoie à Livelox — uniquement quand vous le choisissez. Vos données ne vont nulle part ailleurs, ne sont jamais vendues et ne sont jamais utilisées pour la publicité."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge leser aktivitets-GPS-rutene dine fra Apple Helse og sender dem til Livelox — bare når du velger det. Dataene dine havner aldri noe annet sted, selges aldri og brukes aldri til reklame."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge läser dina aktivitets-GPS-spår från Apple Hälsa och skickar dem till Livelox — bara när du väljer det. Dina data hamnar aldrig någon annanstans, säljs aldrig och används aldrig för reklam."
          }
        }
      }
    },
    "LoxBridge reads your Apple Watch and iPhone activity routes through the Apple Health app to generate GPX files. Tap below to grant access." : {
      "comment" : "OnboardingView - HealthKit step description",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge čte trasy aktivit z Apple Watch a iPhonu prostřednictvím aplikace Apple Health pro generování GPX souborů. Klepnutím níže udělte přístup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge læser dine Apple Watch og iPhone aktivitetsruter via Apple Helbred-appen for at generere GPX-filer. Tryk nedenfor for at give adgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge liest deine Apple Watch- und iPhone-Aktivitätsrouten über die Apple Health App, um GPX-Dateien zu erstellen. Tippe unten, um Zugriff zu gewähren."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge loeb sinu Apple Watchi ja iPhone tegevusradasid Apple Tervise rakenduse kaudu GPX-failide loomiseks. Juurdepääsu andmiseks puuduta allpool."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lukee aktiviteettireittisi Apple Watchilta ja iPhonelta Apple Terveys -sovelluksen kautta GPX-tiedostojen luomiseksi. Napauta alla myöntääksesi käyttöoikeuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lit vos itinéraires d'activité depuis l'Apple Watch et l'iPhone via l'application Apple Santé pour générer des fichiers GPX. Appuyez ci-dessous pour accorder l'accès."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge leser aktivitetsrutene dine fra Apple Watch og iPhone via Apple Helse-appen for å generere GPX-filer. Trykk nedenfor for å gi tilgang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge läser dina aktivitetsrutter från Apple Watch och iPhone via Apple Hälsa för att skapa GPX-filer. Tryck nedan för att ge åtkomst."
          }
        }
      }
    },
    "LoxBridge reads your workouts and GPS routes from the Apple Health app. This data stays on your device and is never shared with anyone other than Livelox, and only when you initiate an upload." : {
      "comment" : "Explanation of how health and workout data is collected by LoxBridge.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge čte vaše tréninky a GPS trasy z aplikace Apple Zdraví. Tato data zůstávají ve vašem zařízení a nikdy nejsou sdílena s nikým jiným než Livelox, a to pouze tehdy, když zahájíte nahrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge læser dine træninger og GPS-ruter fra Apple Sundhed-appen. Disse data forbliver på din enhed og deles aldrig med andre end Livelox, og kun når du starter en upload."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge liest deine Trainings und GPS-Routen aus der Apple Health-App. Diese Daten verbleiben auf deinem Gerät und werden niemals mit anderen als Livelox geteilt, und nur wenn du einen Upload initiierst."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge loeb su treeninguid ja GPS-radu Apple Tervise rakendusest. Need andmed jäävad su seadmesse ega jagata kunagi kellegagi peale Livelox'i, ja ainult siis, kui algatad üleslaadimise."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lukee harjoituksesi ja GPS-reittisi Apple Terveys -sovelluksesta. Nämä tiedot pysyvät laitteessasi eikä niitä jaeta kenellekään muulle kuin Livelox'ille, ja vain kun aloitat latauksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge lit vos entraînements et vos parcours GPS depuis l'application Apple Santé. Ces données restent sur votre appareil et ne sont jamais partagées avec quiconque d'autre que Livelox, et uniquement lorsque vous initiez un téléversement."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge leser treningene og GPS-rutene dine fra Apple Helse-appen. Disse dataene forblir på enheten din og deles aldri med andre enn Livelox, og bare når du starter en opplasting."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge läser dina träningar och GPS-rutter från Apple Hälsa-appen. Dessa data stannar på din enhet och delas aldrig med någon annan än Livelox, och bara när du initierar en uppladdning."
          }
        }
      }
    },
    "LoxBridge will run in the background. After each outdoor activity you'll receive a notification to upload the route." : {
      "comment" : "OnboardingView - all set step description",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge běží na pozadí. Po každé venkovní aktivitě obdržíte oznámení o nahrání trasy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge kører i baggrunden. Efter hver udendørs aktivitet modtager du en notifikation om at uploade ruten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge läuft im Hintergrund. Nach jeder Outdoor-Aktivität erhältst du eine Benachrichtigung zum Hochladen der Route."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge töötab taustal. Pärast iga õuetegevust saad teavituse raja üleslaadimiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge toimii taustalla. Jokaisen ulkoaktiviteetin jälkeen saat ilmoituksen reitin lataamisesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge s'exécute en arrière-plan. Après chaque activité en extérieur, vous recevrez une notification pour transférer l'itinéraire."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoxBridge kjører i bakgrunnen. Etter hver utendørs aktivitet får du et varsel om å laste opp ruten."
