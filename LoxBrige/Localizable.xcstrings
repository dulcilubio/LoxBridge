    "Tap to enable in iOS Settings — otherwise you won't be notified when a route is on Livelox" : {
      "comment" : "A description of the notification settings warning.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím povolíte v nastavení iOS – jinak nebudete informováni, když je trasa na Livelox"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at aktivere i iOS-indstillinger – ellers får du ikke besked, når en rute er på Livelox"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Aktivieren in den iOS-Einstellungen tippen – andernfalls wirst du nicht benachrichtigt, wenn eine Route auf Livelox ist"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta iOS-i seadetes lubamiseks – muidu ei saa teatist, kui rada on Livelox'is"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön napauttamalla iOS-asetuksissa – muuten et saa ilmoituksia, kun reitti on Livelox'issa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour activer dans les réglages iOS — sinon vous ne serez pas notifié quand un parcours est sur Livelox"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å aktivere i iOS-innstillinger — ellers varsles du ikke når en rute er på Livelox"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att aktivera i iOS-inställningar – annars meddelas du inte när en rutt finns på Livelox"
          }
        }
      }
    },
    "The GPS tracks are combined into one route and uploaded to Livelox. The two originals are deleted from this device." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS záznamy jsou sloučeny do jedné trasy a nahrány na Livelox. Dva originály jsou odstraněny z tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS-sporene kombineres til én rute og uploades til Livelox. De to originaler slettes fra denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GPS-Spuren werden zu einer Route zusammengeführt und auf Livelox hochgeladen. Die beiden Originale werden von diesem Gerät gelöscht."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS-rajad ühendatakse üheks rajaks ja laaditakse Livelox'ile üles. Kaks originaali kustutatakse sellest seadmest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS-jäljet yhdistetään yhdeksi reitiksi ja ladataan Livelox'iin. Kaksi alkuperäistä poistetaan tältä laitteelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les traces GPS sont combinées en un seul parcours et téléversées sur Livelox. Les deux originaux sont supprimés de cet appareil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS-sporene kombineres til én rute og lastes opp til Livelox. De to originalene slettes fra denne enheten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS-spåren kombineras till en rutt och laddas upp till Livelox. De två originalen raderas från den här enheten."
          }
        }
      }
    },
    "To record, open the **LoxBridge** app or the **Workout** app on your Apple Watch and choose Outdoor Run" : {
